# SentinelIQ Environment Variables

# Application
ENVIRONMENT=development
RESPONSE_MODE=DRY_RUN
BACKEND_CORS_ORIGINS=["*"]

# Database (PostgreSQL/Supabase)
DATABASE_URL=postgresql://user:password@localhost:5432/sentineliq

# Authentication
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-key
JWT_SECRET=your-jwt-secret
JWT_ALGORITHM=HS256

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200

# Integrations - Wazuh
WAZUH_API_URL=https://wazuh-manager:55000
WAZUH_USER=wazuh-wui
WAZUH_PASSWORD=wazuh-wui

# Integrations - Threat Intel
MISP_URL=https://misp-instance
MISP_KEY=your-misp-key
TAXII_URL=https://taxii-server
